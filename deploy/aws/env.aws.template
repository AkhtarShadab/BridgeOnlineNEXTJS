# AWSDep environment template — BridgeOnline + Redis
#
# Copy values into Lightsail/EC2 .env or ECS task secrets.
# Do NOT commit a filled copy.
#
# Docs: docs/2-deployment-guide/aws-redis-credits.md
# Full AWS map: docs/2-deployment-guide/aws.md

# ── App URL (your Lightsail/EC2 HTTPS hostname) ─────────────────────────────
NEXTAUTH_URL=https://YOUR_AWS_HOST
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# Optional; defaults to window.location.origin in the browser
# NEXT_PUBLIC_SOCKET_URL=https://YOUR_AWS_HOST

# ── Postgres (keep Supabase pooler — this project is on aws-1, NOT aws-0) ───
DATABASE_URL=postgresql://postgres.zxglihcentjhwwxqkprb:YOUR_DB_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.zxglihcentjhwwxqkprb:YOUR_DB_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# ── Redis (required on this branch for higher realtime reliability / TPS) ─
# Same-box:     redis://127.0.0.1:6379
# ElastiCache:  redis://<primary-endpoint>:6379
# TLS on:       rediss://<primary-endpoint>:6379
REDIS_URL=redis://127.0.0.1:6379

# ── Feature flags (Redis-aware) ─────────────────────────────────────────────
FEATURE_RECONNECT_GRACE=true
NEXT_PUBLIC_FEATURE_RECONNECT_GRACE=true

# Optional — enable after Redis is proven healthy:
# FEATURE_HOT_COLD_STATE=true
# FEATURE_ACTION_QUEUE=true
# (ACTION_QUEUE also needs: npm run start:worker)

FEATURE_VOICE_CHAT=false
NEXT_PUBLIC_FEATURE_VOICE_CHAT=false
FEATURE_AI_HINTS=false
FEATURE_HOT_COLD_STATE=false
FEATURE_ACTION_QUEUE=false

NODE_ENV=production
PORT=3000
