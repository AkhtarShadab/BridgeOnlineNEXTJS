# Environment variables (copy to .env and fill in values)

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bridgeonline?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# Socket.io
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Feature 19 — service separation ports. In production, run web/socket/worker
# as separate processes (npm run start:web / start:socket / start:worker).
# In dev, `npm run dev` runs all three in one process (server/index.js).
PORT_WEB=3000
PORT_SOCKET=3001
# RUN_ALL_IN_ONE=1   # set to 0 in production to use the split entries

# Optional: Redis for Socket.io adapter (Feature 16), hot/cold game state (17),
# and BullMQ action queue (18). Unset = in-memory fallback (single-replica dev).
# Production: required for replicas > 1.
# REDIS_URL="redis://localhost:6379"

# Feature 20 — Dynamic TURN credentials for WebRTC voice.
# TURN_SECRET is SERVER-SIDE ONLY (never NEXT_PUBLIC_*). The /api/voice/
# turn-credentials route signs short-lived HMAC credentials per session.
# Unset = no TURN (voice falls back to STUN/host — LAN/local only).
# TURN_URL="turn:turn.example.com:3478?transport=udp"
# TURN_SECRET="your-coturn-static-auth-secret"
# TURN_TTL=3600

# Feature flags (redeploy to apply)
FEATURE_VOICE_CHAT=true
NEXT_PUBLIC_FEATURE_VOICE_CHAT=true
FEATURE_AI_HINTS=false
FEATURE_NEW_UI=false
FEATURE_RECONNECT_GRACE=false
NEXT_PUBLIC_FEATURE_RECONNECT_GRACE=false
# Redis track kill switches (default false until 17/18 ship).
# These select whether the 17/18 code paths USE Redis once REDIS_URL is set;
# they do NOT gate the Socket.io adapter (16), which is capability-gated only.
# FEATURE_HOT_COLD_STATE=false
# FEATURE_ACTION_QUEUE=false
